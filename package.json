{
  "name": "loic-akanda-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Portfolio personnel immersif corporate de Loïc AKANDA — Finance, Audit & Produits Numériques",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "node scripts/build-edition.mjs",
    "build:sky": "PORTFOLIO_EDITION=sky-zenith node scripts/build-edition.mjs",
    "build:lumora": "PORTFOLIO_EDITION=lumora node scripts/build-edition.mjs",
    "build:glide": "PORTFOLIO_EDITION=glide node scripts/build-edition.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit:contrast": "node scripts/verify-contrast.mjs",
    "audit:qa": "node scripts/qa-phase8-audit.mjs",
    "audit:framing": "node scripts/audit-spatial-framing.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.2.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.2.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^26.0.0",
    "typescript": "~5.8.3",
    "vite": "^8.3.6",
    "vitest": "^3.2.7"
  }
}
